#include "resource.h"
#include <afxres.h>
#pragma code_page(65001)

IDD_CHAT DIALOGEX 0, 0, 700, 430
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "TCP Chat"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Tên:", -1, 8, 10, 22, 12
    EDITTEXT IDC_NAME, 32, 7, 100, 16, ES_AUTOHSCROLL
    LTEXT "Server IPv4:", -1, 145, 10, 55, 12
    EDITTEXT IDC_IP, 205, 7, 110, 16, ES_AUTOHSCROLL
    LTEXT "Port:", -1, 325, 10, 25, 12
    EDITTEXT IDC_PORT, 353, 7, 47, 16, ES_NUMBER | ES_AUTOHSCROLL
    PUSHBUTTON "Kết nối", IDC_CONNECT, 415, 6, 85, 18
    PUSHBUTTON "Ngắt kết nối", IDC_DISCONNECT, 510, 6, 85, 18
    LTEXT "Chưa kết nối", IDC_STATUS, 8, 29, 680, 17
    CONTROL "", IDC_USERS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 8, 50, 120, 190
    CONTROL "", IDC_CHAT, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 135, 50, 557, 190
    LTEXT "Chọn một tin để xem đầy đủ:", -1, 8, 247, 230, 12
    EDITTEXT IDC_DETAIL, 8, 262, 684, 65, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Nội dung:", -1, 8, 334, 70, 12
    EDITTEXT IDC_INPUT, 8, 349, 595, 56, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "Send", IDC_SEND, 614, 349, 78, 24
    LTEXT "UTF-8 • TCP", -1, 614, 382, 78, 12
END
